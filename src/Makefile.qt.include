BITCOIN_QT_INCLUDES = -DQT_NO_KEYWORDS -DQT_USE_QSTRINGBUILDER

qt_liblynxqt_a_CPPFLAGS = $(AM_CPPFLAGS) $(BITCOIN_INCLUDES) $(BITCOIN_QT_INCLUDES) \
  $(QT_INCLUDES) $(QT_DBUS_INCLUDES) $(QR_CFLAGS) $(BOOST_CPPFLAGS)
qt_liblynxqt_a_CXXFLAGS = $(AM_CXXFLAGS) $(QT_PIE_FLAGS)
qt_liblynxqt_a_OBJCXXFLAGS = $(AM_OBJCXXFLAGS) $(QT_PIE_FLAGS)

qt_liblynxqt_a_SOURCES = $(BITCOIN_QT_CPP) $(BITCOIN_QT_H) $(QT_FORMS_UI) \
  $(QT_QRC) $(QT_QRC_LOCALE) $(QT_TS) $(QT_RES_FONTS) $(QT_RES_ICONS) $(QT_RES_ANIMATION)
if TARGET_DARWIN
  qt_liblynxqt_a_SOURCES += $(BITCOIN_MM)
endif

nodist_qt_liblynxqt_a_SOURCES = $(QT_MOC_CPP) $(QT_MOC) $(QT_QRC_CPP) $(QT_QRC_LOCALE_CPP)

# forms/foo.h -> forms/ui_foo.h
QT_FORMS_H=$(join $(dir $(QT_FORMS_UI)),$(addprefix ui_, $(notdir $(QT_FORMS_UI:.ui=.h))))

# Most files will depend on the forms and moc files as includes. Generate them
# before anything else.
$(QT_MOC): $(QT_FORMS_H)
$(qt_liblynxqt_a_OBJECTS) $(qt_lynx_qt_OBJECTS) $(lynx_gui_OBJECTS) : | $(QT_MOC)

# bitcoin-qt and bitcoin-gui binaries #
lynx_qt_cppflags = $(AM_CPPFLAGS) $(BITCOIN_INCLUDES) $(BITCOIN_QT_INCLUDES) \
  $(QT_INCLUDES) $(QR_CFLAGS)
lynx_qt_cxxflags = $(AM_CXXFLAGS) $(QT_PIE_FLAGS)

lynx_qt_sources = qt/main.cpp
if TARGET_WINDOWS
  lynx_qt_sources += $(BITCOIN_QT_RC)
endif
lynx_qt_ldadd = qt/liblynxqt.a $(LIBBITCOIN_NODE)
if ENABLE_WALLET
lynx_qt_ldadd += $(LIBBITCOIN_UTIL) $(LIBBITCOIN_WALLET)
endif
if ENABLE_ZMQ
lynx_qt_ldadd += $(LIBBITCOIN_ZMQ) $(ZMQ_LIBS)
endif
lynx_qt_ldadd += $(LIBBITCOIN_CLI) $(LIBBITCOIN_COMMON) $(LIBBITCOIN_UTIL) $(LIBBITCOIN_CONSENSUS) $(LIBBITCOIN_CRYPTO) $(LIBUNIVALUE) $(LIBLEVELDB) $(LIBMEMENV) \
  $(QT_LIBS) $(QT_DBUS_LIBS) $(QR_LIBS) $(BDB_LIBS) $(MINIUPNPC_LIBS) $(NATPMP_LIBS) $(LIBSECP256K1) \
  $(EVENT_PTHREADS_LIBS) $(EVENT_LIBS) $(SQLITE_LIBS)
lynx_qt_ldflags = $(RELDFLAGS) $(AM_LDFLAGS) $(QT_LDFLAGS) $(LIBTOOL_APP_LDFLAGS) $(PTHREAD_FLAGS)
lynx_qt_libtoolflags = $(AM_LIBTOOLFLAGS) --tag CXX

qt_lynx_qt_CPPFLAGS = $(lynx_qt_cppflags)
qt_lynx_qt_CXXFLAGS = $(lynx_qt_cxxflags)
qt_lynx_qt_SOURCES = $(lynx_qt_sources) init/bitcoin-qt.cpp
qt_lynx_qt_LDADD = $(lynx_qt_ldadd) $(CRYPTO_LIBS)
qt_lynx_qt_LDFLAGS = $(lynx_qt_ldflags)
qt_lynx_qt_LIBTOOLFLAGS = $(lynx_qt_libtoolflags)

lynx_gui_CPPFLAGS = $(lynx_qt_cppflags)
lynx_gui_CXXFLAGS = $(lynx_qt_cxxflags)
lynx_gui_SOURCES = $(lynx_qt_sources) init/bitcoin-gui.cpp
lynx_gui_LDADD = $(lynx_qt_ldadd) $(CRYPTO_LIBS) $(LIBBITCOIN_IPC) $(LIBBITCOIN_UTIL) $(LIBMULTIPROCESS_LIBS)
lynx_gui_LDFLAGS = $(lynx_qt_ldflags)
lynx_gui_LIBTOOLFLAGS = $(lynx_qt_libtoolflags)

#locale/foo.ts -> locale/foo.qm
QT_QM=$(QT_TS:.ts=.qm)

SECONDARY: $(QT_QM)

$(srcdir)/qt/bitcoinstrings.cpp: FORCE
	@test -n $(XGETTEXT) || echo "xgettext is required for updating translations"
	$(AM_V_GEN) cd $(srcdir); XGETTEXT=$(XGETTEXT) COPYRIGHT_HOLDERS="$(COPYRIGHT_HOLDERS)" $(PYTHON) ../share/qt/extract_strings_qt.py $(liblynx_node_a_SOURCES) $(liblynx_wallet_a_SOURCES) $(liblynx_common_a_SOURCES) $(liblynx_zmq_a_SOURCES) $(liblynx_consensus_a_SOURCES) $(liblynx_util_a_SOURCES)

# The resulted bitcoin_en.xlf source file should follow Transifex requirements.
# See: https://docs.transifex.com/formats/xliff#how-to-distinguish-between-a-source-file-and-a-translation-file
translate: $(srcdir)/qt/bitcoinstrings.cpp $(QT_FORMS_UI) $(QT_FORMS_UI) $(BITCOIN_QT_BASE_CPP) qt/bitcoin.cpp $(BITCOIN_QT_WINDOWS_CPP) $(BITCOIN_QT_WALLET_CPP) $(BITCOIN_QT_H) $(BITCOIN_MM)
	@test -n $(LUPDATE) || echo "lupdate is required for updating translations"
	$(AM_V_GEN) QT_SELECT=$(QT_SELECT) $(LUPDATE) -no-obsolete -I $(srcdir) -locations relative $^ -ts $(srcdir)/qt/locale/bitcoin_en.ts
	@test -n $(LCONVERT) || echo "lconvert is required for updating translations"
	$(AM_V_GEN) QT_SELECT=$(QT_SELECT) $(LCONVERT) -drop-translations -o $(srcdir)/qt/locale/bitcoin_en.xlf -i $(srcdir)/qt/locale/bitcoin_en.ts
	@$(SED) -i.old -e 's|source-language="en" target-language="en"|source-language="en"|' -e '/<target xml:space="preserve"><\/target>/d' $(srcdir)/qt/locale/bitcoin_en.xlf
	@rm -f $(srcdir)/qt/locale/bitcoin_en.xlf.old

$(QT_QRC_LOCALE_CPP): $(QT_QRC_LOCALE) $(QT_QM)
	@test -f $(RCC)
	@cp -f $< $(@D)/temp_$(<F)
	$(AM_V_GEN) QT_SELECT=$(QT_SELECT) $(RCC) -name bitcoin_locale --format-version 1 $(@D)/temp_$(<F) > $@
	@rm $(@D)/temp_$(<F)

# Per-chain application artwork.
#
# Two generated, untracked files are selected per chain, both by the same three-step
# lookup: the chain's own art, else the Lynx art, else fail the build. Falling back to
# Lynx rather than to a stock Bitcoin asset is deliberate - it is what makes it impossible
# to ship a Bitcoin-branded wallet by accident - and the final failure is a repo-integrity
# check, since share/branding/lynx/ must always exist.
#
#   chain_icon.png  bitcoin.qrc's "bitcoin" alias: window, tray, splash, About dialog
#   chain_icon.ico  the Windows PE icon, compiled in by windres via bitcoin-qt-res.rc
#
# Both live next to the .qrc because rcc and windres resolve paths relative to their own
# input file. Compare-then-copy keeps their mtimes stable, so the resources are regenerated
# exactly when the artwork really changes; the FORCE prerequisite makes 'make NAME=<other>'
# re-brand the same tree without a clean.
#
# Artwork is committed, never generated here: contrib/branding/branding.py is a maintainer
# tool, so no build host needs Pillow or ImageMagick.
#
# The two lookups below are spelled out separately rather than shared via a make
# 'define ... endef' helper. automake cannot handle define blocks in an included
# Makefile.am fragment: it strips the define/endef lines, reinterprets the body as a
# variable assignment, and silently DROPS the rules that follow, with no warning at
# automake time. The failure only surfaces as a missing generated file mid-build.
QT_CHAIN_ICON = $(srcdir)/qt/res/icons/chain_icon.png
QT_CHAIN_ICO = $(srcdir)/qt/res/icons/chain_icon.ico

$(QT_CHAIN_ICON): FORCE
	@src=$(top_srcdir)/share/branding/$(NAME)/icon.png; \
	if test ! -f $$src; then \
	  src=$(top_srcdir)/share/branding/lynx/icon.png; \
	  test -f $$src || { echo "ERROR: chain '$(NAME)' has no icon.png and no Lynx fallback at $$src" >&2; exit 1; }; \
	  echo "  FALLBACK $@ <- $$src (chain '$(NAME)' has no icon.png)"; \
	fi; \
	cmp -s $$src $@ 2>/dev/null || { echo "  BRAND    $@ <- $$src"; cp -f $$src $@; }

$(QT_CHAIN_ICO): FORCE
	@src=$(top_srcdir)/share/branding/$(NAME)/icon.ico; \
	if test ! -f $$src; then \
	  src=$(top_srcdir)/share/branding/lynx/icon.ico; \
	  test -f $$src || { echo "ERROR: chain '$(NAME)' has no icon.ico and no Lynx fallback at $$src" >&2; exit 1; }; \
	  echo "  FALLBACK $@ <- $$src (chain '$(NAME)' has no icon.ico)"; \
	fi; \
	cmp -s $$src $@ 2>/dev/null || { echo "  BRAND    $@ <- $$src"; cp -f $$src $@; }

# windres embeds chain_icon.ico into the Qt binary, so the object has to be rebuilt when
# the icon changes. The object name is unprefixed even though qt_lynx_qt_CPPFLAGS exists,
# because the .rc.o suffix rule in Makefile.am bypasses automake's per-target naming.
qt/res/bitcoin-qt-res.$(OBJEXT): $(QT_CHAIN_ICO)

# ── Linux desktop integration ───────────────────────────────────────────────────
# This only affects 'make install'. The .zip archives this project actually ships do not
# run it, so it is groundwork for distro packaging - plus it is what makes the Icon= key
# resolve in the autostart file written by GUIUtil::SetStartOnSystemStartup().
#
# Installed per chain, named after the chain rather than after the artwork:
#   $(datadir)/pixmaps/<chain>.png        what Icon=<chain> resolves against
#   $(datadir)/applications/<chain>.desktop   launcher entry
#
# Both are installed by hand rather than through an automake _DATA primary, because a
# _DATA primary installs a file under its source basename and every chain's source file is
# called icon.png.
QT_CHAIN_DESKTOP = $(NAME).desktop

# Name= is a plain capitalisation of the chain id, because CurrentChainDisplayName() is a
# C++ function the build cannot call. That matches the display name for every chain except
# infiniloop, which renders "InfiniLooP" inside the wallet but "Infiniloop" here.
$(QT_CHAIN_DESKTOP): FORCE
	@{ echo "[Desktop Entry]"; \
	   echo "Type=Application"; \
	   echo "Version=1.0"; \
	   echo "Name=$$(echo '$(NAME)' | sed 's/^./\U&/')"; \
	   echo "Comment=$$(echo '$(NAME)' | sed 's/^./\U&/') peer-to-peer wallet and full node"; \
	   echo "Exec=$(NAME)-qt %u"; \
	   echo "Icon=$(NAME)"; \
	   echo "Terminal=false"; \
	   echo "Categories=Office;Finance;"; \
	   echo "MimeType=x-scheme-handler/$(NAME);"; \
	   echo "StartupWMClass=$(NAME)-qt"; \
	} > $@.tmp
	@cmp -s $@.tmp $@ 2>/dev/null && rm -f $@.tmp || { mv -f $@.tmp $@; echo "  GEN      $@"; }

install-data-local: $(QT_CHAIN_DESKTOP) $(QT_CHAIN_ICON)
	$(MKDIR_P) $(DESTDIR)$(datadir)/pixmaps $(DESTDIR)$(datadir)/applications
	$(INSTALL_DATA) $(QT_CHAIN_ICON) $(DESTDIR)$(datadir)/pixmaps/$(NAME).png
	$(INSTALL_DATA) $(QT_CHAIN_DESKTOP) $(DESTDIR)$(datadir)/applications/$(NAME).desktop

uninstall-local:
	-rm -f $(DESTDIR)$(datadir)/pixmaps/$(NAME).png
	-rm -f $(DESTDIR)$(datadir)/applications/$(NAME).desktop

$(QT_QRC_CPP): $(QT_QRC) $(QT_FORMS_H) $(QT_RES_FONTS) $(QT_RES_ICONS) $(QT_RES_ANIMATION) $(QT_CHAIN_ICON)
	@test -f $(RCC)
	$(AM_V_GEN) QT_SELECT=$(QT_SELECT) $(RCC) -name bitcoin --format-version 1 $< > $@

CLEAN_QT = $(nodist_qt_liblynxqt_a_SOURCES) $(QT_QM) $(QT_FORMS_H) qt/*.gcda qt/*.gcno qt/temp_bitcoin_locale.qrc $(QT_CHAIN_ICON) $(QT_CHAIN_ICO) $(QT_CHAIN_DESKTOP)

CLEANFILES += $(CLEAN_QT)

lynx_qt_clean: FORCE
	rm -f $(CLEAN_QT) $(qt_liblynxqt_a_OBJECTS) $(qt_lynx_qt_OBJECTS) qt/lynx-qt$(EXEEXT) $(LIBBITCOINQT)

lynx_qt : qt/lynx-qt$(EXEEXT)

APK_LIB_DIR = qt/android/libs/$(ANDROID_ARCH)
QT_BASE_VERSION = $(lastword $(shell $(MOC) --version))
QT_BASE_PATH = $(shell find ../depends/sources/ -maxdepth 1 -type f -regex ".*qtbase.*$(QT_BASE_VERSION)\.tar.xz")
QT_BASE_TLD = $(shell tar tf $(QT_BASE_PATH) --exclude='*/*')

lynx_qt_apk: FORCE
	mkdir -p $(APK_LIB_DIR)
	cp $(dir $(lastword $(CC)))../sysroot/usr/lib/$(host_alias)/libc++_shared.so $(APK_LIB_DIR)
	tar xf $(QT_BASE_PATH) -C qt/android/src/ $(QT_BASE_TLD)src/android/jar/src --strip-components=5
	tar xf $(QT_BASE_PATH) -C qt/android/src/ $(QT_BASE_TLD)src/android/java/src --strip-components=5
	cp qt/lynx-qt $(APK_LIB_DIR)/liblynx-qt_$(ANDROID_ARCH).so
	cd qt/android && gradle wrapper --gradle-version=6.6.1
	cd qt/android && ./gradlew build

ui_%.h: %.ui
	@test -f $(UIC)
	@$(MKDIR_P) $(@D)
	$(AM_V_GEN) QT_SELECT=$(QT_SELECT) $(UIC) -o $@ $< || (echo "Error creating $@"; false)

%.moc: %.cpp
	$(AM_V_GEN) QT_SELECT=$(QT_SELECT) $(MOC) $(DEFAULT_INCLUDES) $(QT_INCLUDES_UNSUPPRESSED) $(MOC_DEFS) $< > $@

moc_%.cpp: %.h
	$(AM_V_GEN) QT_SELECT=$(QT_SELECT) $(MOC) $(DEFAULT_INCLUDES) $(QT_INCLUDES_UNSUPPRESSED) $(MOC_DEFS) $< > $@

%.qm: %.ts
	@test -f $(LRELEASE)
	@$(MKDIR_P) $(@D)
	$(AM_V_GEN) QT_SELECT=$(QT_SELECT) $(LRELEASE) -silent $< -qm $@
